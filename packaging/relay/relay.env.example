# Copy to relay.env and fill in. Every variable the Relay reads can go here; the image bakes in
# only RAVENGLASS_RELAY_LISTEN=0.0.0.0:8743. See crates/ravenglass-relay/src/main.rs.

# Required: the shared bearer token, at least 16 characters (e.g. `openssl rand -base64 32`).
RAVENGLASS_RELAY_TOKEN=

# The web app's origin, the only one allowed to call from a browser.
# RAVENGLASS_RELAY_ORIGIN=https://mail.example.com

# Serve the built-in demo accounts (for trying it out).
# RAVENGLASS_RELAY_DEMO=1
