<?xml version="1.0" encoding="utf-8"?>
<!-- Registers Ravenglass as a mail client Windows can offer for mailto: links (Settings > Apps >
     Default apps) without taking the links over: cargo-packager's deep-link-protocols option
     would overwrite HKLM\Software\Classes\mailto, and delete it again on uninstall.
     Linked into the MSI through wix.fragment-paths and wix.component-group-refs in app/Cargo.toml.
     [#Path] is the full path of the installed ravenglass.exe (File Id="Path" in the main template). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="RavenglassMailClient">
      <Component Id="RavenglassMailClientRegistration" Directory="INSTALLDIR" Guid="7C1C3B5E-2C1B-4C55-9C43-6B7C6E0B6A51">
        <RegistryKey Root="HKLM" Key="Software\Classes\Ravenglass.mailto">
          <RegistryValue Type="string" Value="Ravenglass mailto link" KeyPath="yes"/>
          <RegistryValue Type="string" Name="URL Protocol" Value=""/>
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#Path]&quot;,0"/>
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;"/>
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Clients\Mail\Ravenglass">
          <RegistryValue Type="string" Value="Ravenglass"/>
          <RegistryKey Key="Capabilities">
            <RegistryValue Type="string" Name="ApplicationName" Value="Ravenglass"/>
            <RegistryValue Type="string" Name="ApplicationDescription" Value="A character-grid mail client"/>
            <RegistryValue Type="string" Name="ApplicationIcon" Value="&quot;[#Path]&quot;,0"/>
            <RegistryKey Key="URLAssociations">
              <RegistryValue Type="string" Name="mailto" Value="Ravenglass.mailto"/>
            </RegistryKey>
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#Path]&quot;"/>
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Type="string" Name="Ravenglass" Value="Software\Clients\Mail\Ravenglass\Capabilities"/>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
